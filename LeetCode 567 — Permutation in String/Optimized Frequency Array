def checkInclusion(s1, s2):
    m = len(s1)
    n = len(s2)

    if m > n:
        return False

    need = [0] * 26
    window = [0] * 26

    for char in s1:
        index = ord(char) - ord("a")
        need[index] += 1

    for i in range(m):
        index = ord(s2[i]) - ord("a")
        window[index] += 1

    matches = 0

    for i in range(26):
        if need[i] == window[i]:
            matches += 1

    if matches == 26:
        return True

    for right in range(m, n):
        out_idx = ord(s2[right - m]) - ord("a")
        in_idx = ord(s2[right]) - ord("a")

        if need[out_idx] == window[out_idx]:
            matches -= 1

        window[out_idx] -= 1

        if need[out_idx] == window[out_idx]:
            matches += 1

        if need[in_idx] == window[in_idx]:
            matches -= 1

        window[in_idx] += 1

        if need[in_idx] == window[in_idx]:
            matches += 1

        if matches == 26:
            return True

    return False